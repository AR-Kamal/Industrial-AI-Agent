# Copy this file to .env for local development.
# Generate a unique value; never reuse this example in a shared environment.
SECRET_KEY=replace-with-a-long-random-local-development-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
LOG_LEVEL=INFO

# Local text-generation provider. Ollama ignores the API key, but the
# placeholder keeps this configuration compatible with the gateway contract.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_TEXT_MODEL=gemma3:4b
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=800

# Knowledge-base ingestion. Token counts are deterministic approximations until
# an embedding/tokenization model is selected.
INGESTION_TARGET_CHUNK_TOKENS=600
INGESTION_CHUNK_OVERLAP_TOKENS=75
INGESTION_MIN_CHUNK_TOKENS=100
INGESTION_MAX_CHUNK_TOKENS=900
KNOWLEDGE_MAX_UPLOAD_BYTES=52428800
